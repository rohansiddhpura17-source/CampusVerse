# ==============================================================================
# CampusVerse Production Environment Variables Template
# Copy to .env.production on secure deployment server / container task definition.
# NEVER commit real production secrets to version control.
# ==============================================================================

# Server
PORT=4000
NODE_ENV=production

# Database (Managed PostgreSQL - e.g. Supabase / AWS RDS in ap-south-1 Mumbai)
# Pooled connection string (Port 6543 for Supabase Supavisor)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=20"
# Direct connection string for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT Authentication (64-byte high-entropy hex string)
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# CORS (Strict production domain whitelist, comma-separated)
CORS_ORIGIN="https://campusverse.edu,https://app.campusverse.edu,https://admin.campusverse.edu"

# Email Delivery (Resend - Production domain campusverse.edu)
OTP_EMAIL_PROVIDER="resend"
OTP_FROM_EMAIL="auth@campusverse.edu"
OTP_FROM_NAME="CampusVerse"
RESEND_API_KEY=""

# Gemini AI (Backend API Key)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# Payments (Razorpay Live Production)
PAYMENT_PROVIDER="RAZORPAY"
PAYMENT_CURRENCY="INR"
PAYMENT_SANDBOX_MODE="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Automated Backup & Disaster Recovery (Supabase Storage)
BACKUP_ENCRYPTION_KEY=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_BACKUP_BUCKET="campusverse-database-backups"
# Recommended Supabase API key (sb_secret_...). Legacy SUPABASE_SERVICE_ROLE_KEY also supported.
SUPABASE_SECRET_KEY=""
BACKUP_RETENTION_DAYS="30"
